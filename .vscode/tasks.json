{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AutoCare: Mobile (QR Expo)",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "start",
        "--",
        "--lan"
      ],
      "options": {
        "cwd": "${workspaceFolder}/mobile"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      }
    },
    {
      "label": "AutoCare: Backend",
      "type": "shell",

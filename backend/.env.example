DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/car_maintenance_personal
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=3000

# Local development mailbox, never use preview mode in production.
MAIL_MODE=preview
# For real email: MAIL_MODE=smtp and configure the values below.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# MAIL_FROM=Htsofttechcare <no-reply@example.com>

# First admin only: set these locally, then npm run admin:create. No default account.
# ADMIN_EMAIL=your-admin@example.com
# ADMIN_NAME=System Admin
# ADMIN_PASSWORD=choose-a-strong-unique-password
